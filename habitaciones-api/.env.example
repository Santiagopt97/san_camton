# Copiar este archivo como .env y completar con los datos reales.
# Nunca subir el .env real a git.

# Supabase → Project Settings → Database → Connection string → modo "Transaction pooler"
SUPABASE_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.PROJECT_REF
SUPABASE_PASSWORD=

# Debe ser IDÉNTICA en auth-api, clientes-api y habitaciones-api
JWT_KEY=CAMBIAR-por-una-clave-larga-de-minimo-32-caracteres-compartida-con-los-APIs
JWT_ISSUER=hotel-auth
JWT_AUDIENCE=hotel-apis

# El front de habitaciones (5174) y la landing pública (5177)
CORS_ORIGINS=http://localhost:5174,http://localhost:5177

# Supabase Storage (imágenes de habitaciones). Settings → API Keys.
# La secret key es solo para el backend: nunca en el front ni en git.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=habitaciones
